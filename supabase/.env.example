# SERVER ONLY. Copy to supabase/.env and never commit it.
# SUPABASE_URL is provided automatically in hosted Edge Functions.
# Optional override: uses the hosted SUPABASE_SECRET_KEYS default otherwise.
# You can create a dedicated secret key in Supabase > Settings > API keys.
WAITLIST_SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
# Exact origins, comma-separated, no trailing slash. No wildcard.
ALLOWED_ORIGINS=https://parlonsmoi.luckyharp1.chatgpt.site
# Exact hostnames in your Turnstile widget, comma-separated.
TURNSTILE_HOSTNAMES=parlonsmoi.luckyharp1.chatgpt.site
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WAITLIST_HMAC_SECRET=
